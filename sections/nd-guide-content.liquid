<div class="page-width">
  <div class="guide__wrapper">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'text' %}
          <div class="guide__block guide__block--text" {{ block.shopify_attributes }}>
            {% if block.settings.heading %}
              <h2 class="guide__heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.content %}
              <div class="guide__rte rte">{{ block.settings.content }}</div>
            {% endif %}
          </div>

        {% when 'media_list' %}
          {%- assign media_items = block.settings.items | newline_to_br | split: '<br />' -%}
          <div class="guide__block guide__block--media" {{ block.shopify_attributes }}>
            <div class="grid grid--2-col grid--1-col-tablet-down guide__media-grid">
              <div class="grid__item">
                {% if block.settings.heading %}
                  <h2 class="guide__heading">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.content %}
                  <div class="guide__rte rte">{{ block.settings.content }}</div>
                {% endif %}
                {% if media_items.size > 0 %}
                  <ul class="guide__list" role="list">
                    {% for item in media_items %}
                      {%- assign item_text = item | strip -%}
                      {% if item_text != blank %}
                        <li class="guide__list-item">
                          <span class="guide__list-icon" aria-hidden="true">
                            <svg width="12" height="9" viewBox="0 0 12 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M1 4.5L4.33333 7.83333L11 1.16667" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span>{{ item_text }}</span>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
              <div class="grid__item">
                <div class="guide__media">
                  {% if block.settings.image %}
                    <img
                      src="{{ block.settings.image | img_url: '900x' }}"
                      alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                      loading="lazy"
                      width="900"
                      height="600">
                  {% else %}
                    <img
                      src="{{ 'face-split.png' | asset_url }}"
                      alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                      loading="lazy"
                      width="900"
                      height="600">
                  {% endif %}
                </div>
                {% if block.settings.caption %}
                  <p class="guide__media-caption">{{ block.settings.caption }}</p>
                {% endif %}
              </div>
            </div>
          </div>

        {% when 'steps' %}
          {%- assign steps = block.settings.items | newline_to_br | split: '<br />' -%}
          <div class="guide__block guide__block--steps" {{ block.shopify_attributes }}>
            {% if block.settings.heading %}
              <h2 class="guide__heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.content %}
              <div class="guide__rte rte">{{ block.settings.content }}</div>
            {% endif %}
            {% if steps.size > 0 %}
              <ol class="guide__steps" role="list">
                {% assign step_number = 0 %}
                {% for step in steps %}
                  {%- assign step_text = step | strip -%}
                  {% if step_text != blank %}
                    {% assign step_number = step_number | plus: 1 %}
                    <li class="guide__step">
                      <span class="guide__step-number">{{ step_number }}</span>
                      <span class="guide__step-text">{{ step_text }}</span>
                    </li>
                  {% endif %}
                {% endfor %}
              </ol>
            {% endif %}
          </div>

        {% when 'callout' %}
          <div class="guide__block guide__block--callout" {{ block.shopify_attributes }}>
            <div class="guide__callout">
              {% if block.settings.heading %}
                <h3 class="guide__callout-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.content %}
                <div class="guide__rte rte">{{ block.settings.content }}</div>
              {% endif %}
            </div>
          </div>

        {% when 'cta' %}
          {%- assign cta_modifier = 'guide__cta--light' -%}
          {% if block.settings.color_scheme == 'dark' %}
            {%- assign cta_modifier = 'guide__cta--dark' -%}
          {% endif %}
          <div class="guide__block guide__block--cta" {{ block.shopify_attributes }}>
            <div class="guide__cta {{ cta_modifier }}">
              <div class="guide__cta-content">
                {% if block.settings.heading %}
                  <h3 class="guide__cta-heading">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.description %}
                  <p class="guide__cta-text">{{ block.settings.description }}</p>
                {% endif %}
              </div>
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                {%- assign button_class = 'th-btn' -%}
                {% if block.settings.color_scheme == 'dark' %}
                  {%- assign button_class = 'th-btn th-btn--light' -%}
                {% endif %}
                <a href="{{ block.settings.button_link }}" class="{{ button_class }} guide__cta-button">
                  <span class="th-btn__label">{{ block.settings.button_label }}</span>
                  <span class="th-btn__icon">
                    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </a>
              {% endif %}
            </div>
          </div>

      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "ND Guide Content",
  "tag": "section",
  "class": "section guide",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What Is Microneedling?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Microneedling uses a pen fitted with a disposable cartridge containing very small needles. As the device moves across the skin, the cartridge creates controlled microchannels at the skin's surface as part of a cosmetic skincare routine.</p>"
        }
      ]
    },
    {
      "type": "media_list",
      "name": "Text With Image",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What Can Microneedling Help Improve The Appearance Of?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "List Items",
          "info": "One item per line.",
          "default": "Fine lines\nUneven-looking skin texture\nEnlarged-looking pores\nDull or tired-looking skin\nUneven-looking tone\nSkin that appears less smooth or firm"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the split-face image included with the theme."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Image Caption"
        }
      ]
    },
    {
      "type": "steps",
      "name": "Numbered Steps",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "How Does It Work?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Steps",
          "info": "One step per line.",
          "default": "Choose your Dr. Pen\nChoose a compatible cartridge\nCleanse and prepare the skin\nUse the device according to the instructions for your model\nFollow with a simple, gentle skincare routine"
        }
      ]
    },
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Important to Know"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Always follow the instructions included with your device.</p>"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Call To Action",
      "settings": [
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color Scheme",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ready to Get Started?"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Find the Dr. Pen that fits your experience level and skincare routine."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Find Your Dr. Pen"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ND Guide Content",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "media_list"
        },
        {
          "type": "steps"
        },
        {
          "type": "callout"
        },
        {
          "type": "cta"
        }
      ]
    }
  ]
}
{% endschema %}
